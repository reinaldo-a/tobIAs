@startuml
class Sistema {
    +cadastrarUsuario(usuario: Usuario): void
    +cadastrarProfessor(professor: Professor): void
    +cadastrarMateria(materia: Materia): void
    +acompanharDesempenho(aluno: Aluno): void
}

class Usuario {
    +nome: string
    +email: string
    +verProgresso(): void
}

class Aluno {
    +matricula: string
    +historico: List<Historico>
    +verDesempenho(): void
}

class Professor {
    +nome: string
    +email: string
    +postarMaterial(materia: Material): void
    +gerarAtividade(material: Material): void
}

class Materia {
    +nome: string
    +materiais: List<Material>
    +adicionarMaterial(material: Material): void
}

class Material {
    +titulo: string
    +texto: string
    +arquivo: string
    +gerarResumo(): string
    +gerarQuestoes(): List<Questao>
}

class Historico {
    +data: string
    +materia: string
    +nota: float
    +comentarios: string
}

class Questao {
    +enunciado: string
    +alternativas: List<string>
    +respostaCorreta: int
    +verificarResposta(resposta: int): boolean
}

class IAEstudo {
    +gerarResumo(texto: string): string
    +gerarQuestoes(texto: string): List<Questao>
    +processarMaterial(arquivo: string): string
    +analisarDesempenho(aluno: Aluno): void
}

Sistema -down-> Usuario
Sistema -down-> Professor
Sistema -down-> Aluno
Sistema -down-> Materia
Materia -down-> Material
Material -down-> Questao
Aluno -down-> Historico
Sistema -down-> IAEstudo
IAEstudo -right-> Aluno
@enduml