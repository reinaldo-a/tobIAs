@startuml

title Sistema de Apoio Inteligente ao Estudo

'========================
' CLASSE ABSTRATA USUÁRIO
'========================
abstract class Usuario {
    -id: int
    -nome: String
    -email: String
    -senha: String

    +login()
    +logout()
    +visualizarDashboard()
}

'========================
' HERANÇA
'========================
class Professor {
    +criarDisciplina()
    +publicarConteudo()
    +criarAtividade()
    +acompanharDesempenho()
}

class Aluno {
    +estudarConteudo()
    +realizarAtividade()
    +solicitarAjuda()
}

Usuario <|-- Professor
Usuario <|-- Aluno


'========================
' DISCIPLINA
'========================
class Disciplina {
    -id: int
    -nome: String
    -descricao: String

    +adicionarConteudo()
    +adicionarAluno()
}

'========================
' CONTEÚDO
'========================
class Conteudo {
    -id: int
    -titulo: String
    -material: String

    +exibirConteudo()
}

'========================
' ATIVIDADE
'========================
class Atividade {
    -id: int
    -titulo: String
    -descricao: String

    +avaliarResposta()
}

'========================
' QUESTÃO
'========================
abstract class Questao {
    -enunciado: String

    +corrigirResposta()
}

class QuestaoMultiplaEscolha {
    -alternativas: List
    -respostaCorreta: String

    +corrigirResposta()
}

class QuestaoDissertativa {
    +corrigirResposta()
}

Questao <|-- QuestaoMultiplaEscolha
Questao <|-- QuestaoDissertativa


'========================
' INTELIGÊNCIA ARTIFICIAL
'========================
class InteligenciaArtificial {
    +explicarConteudo()
    +gerarExercicios()
    +sugerirMaterial()
}

'========================
' RELATÓRIO
'========================
class RelatorioDesempenho {
    +gerarRelatorio()
}


'========================
' COMPOSIÇÃO
'========================
Disciplina *-- Conteudo
Disciplina *-- Atividade

Atividade *-- Questao


'========================
' AGREGAÇÃO
'========================
Disciplina o-- Aluno


'========================
' ASSOCIAÇÕES
'========================
Professor -- Disciplina : gerencia
Aluno -- Atividade : realiza
Aluno -- Conteudo : estuda

InteligenciaArtificial -- Aluno : auxilia
InteligenciaArtificial -- Professor : apoia

Professor -- RelatorioDesempenho
RelatorioDesempenho -- Aluno


'========================
' POLIMORFISMO
'========================
note right of Questao
Método polimórfico:

corrigirResposta()

Implementado de forma diferente em:

QuestaoMultiplaEscolha
QuestaoDissertativa
end note


@enduml