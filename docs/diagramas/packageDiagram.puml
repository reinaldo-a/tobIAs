@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam ArrowColor #555555

title Diagrama de Pacotes (Arquitetura Macro) - LearnAI/TobIAs

actor "Cliente Web" as client

package "Apresentação e Frontend" #F9F9F9 {
    package "WEB-INF/templates" as templates
    package "assets" as assets
}

package "com.tobias (Backend Java)" {
    
    package "filter" as filter #E6F4EA
    package "controller" as controller #E6F4EA
    package "application" as app #E6F4EA
    
    package "service.ai" as service_ai #FFE5A3
    package "dto" as dto #E6F4EA
    
    package "model" as model #E6F4EA
    package "dao" as dao #D0E1FD
    package "config" as config #F2F2F2
}

package "Persistência" {
    package "bd/migration" as migrations #F9F9F9
    database "PostgreSQL" as postgres #D0E1FD
}

' --- FLUXO E DEPENDÊNCIAS ---

client ..> filter : "Requisição HTTP"
filter ..> controller : "Valida acesso"

' Camada Web
controller ..> templates : "Renderiza Views"
controller ..> app : "Usa utilitários"
controller ..> model : "Manipula entidades"
controller ..> dao : "Lê/Escreve dados"
controller ..> service_ai : "Delega operações de IA"
controller ..> dto : "Recebe respostas da IA"

' Camada de Serviço (IA)
service_ai ..> gemini_api : "Consome API"
service_ai ..> dto : "Usa contratos de dados"
service_ai ..> model : "Lê contexto do domínio"

' Camada de Dados
dao ..> postgres : "Comandos SQL/JDBC"
dao ..> model : "Mapeia dados"

' Infraestrutura
config ..> migrations : "Aplica Flyway"
config .> postgres : "configura conexao"

' Views
templates ..> assets : "Carrega recursos"

@enduml